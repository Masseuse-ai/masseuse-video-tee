# Copy to terraform.tfvars and fill in. The controller's values come from
# the service whose controller your project was approved for; the
# operator's come from its hosted_slots output.

project_id = "your-project"

slots = {
  "slot-0" = { zone = "us-central1-a", host = "slot-0.enclave.example.com" }
}

network     = "projects/your-project/global/networks/your-vpc"
subnetworks = { "us-central1" = "projects/your-project/regions/us-central1/subnetworks/your-subnet" }

controller_url             = "https://controller.example.com"
controller_service_account = "controller@example.iam.gserviceaccount.com"

container_image   = "us-central1-docker.pkg.dev/<operator project>/<repository>/<image>@sha256:<release digest>"
signature_repo    = "us-central1-docker.pkg.dev/<operator project>/<repository>/<image>"
models_bucket     = "<operator project>-models"
wif_audience      = "//iam.googleapis.com/projects/<operator project number>/locations/global/workloadIdentityPools/hosted-slots/providers/attestation-hosted"
hosted_principals = ["principalSet://iam.googleapis.com/projects/<operator project number>/locations/global/workloadIdentityPools/hosted-slots/attribute.image_digest/sha256:<release digest>"]

acme_contact_email = "ops@example.com"
